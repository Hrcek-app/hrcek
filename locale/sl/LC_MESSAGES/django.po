#: src/hrcek/accounts/templates/accounts/account.html
#: src/hrcek/core/templates/base.html
msgid "Your account"
msgstr "Vaš račun"

#: src/hrcek/accounts/templates/accounts/account.html
msgid "Save display name"
msgstr "Shrani prikazno ime"

#: src/hrcek/accounts/templates/accounts/account.html
msgid "Public name"
msgstr "Javno ime"

#: src/hrcek/accounts/templates/accounts/account.html
msgid ""
"Only needed if you make a collection public. Your public name appears in the "
"address of every public collection you have, like /u/your-name/watches/."
msgstr ""
"Potrebno le, če zbirko objavite. Vaše javno ime se pojavi v naslovu vsake "
"vaše javne zbirke, na primer /u/vase-ime/ure/."

#: src/hrcek/accounts/templates/accounts/account.html
msgid ""
"You have public collections. Changing your public name changes their "
"addresses, and any link you have already shared will stop working."
msgstr ""
"Imate javne zbirke. Sprememba javnega imena spremeni njihove naslove in vse "
"že deljene povezave bodo nehale delovati."

#: src/hrcek/accounts/templates/accounts/account.html
msgid "Save public name"
msgstr "Shrani javno ime"

#: src/hrcek/accounts/templates/accounts/account.html
#, python-format
msgid ""
"Waiting for confirmation at %(pending)s. Until you confirm it, this address "
"keeps working."
msgstr ""
"Čakamo na potrditev na %(pending)s. Dokler je ne potrdite, ta naslov še "
"naprej deluje."

#: src/hrcek/accounts/templates/accounts/account.html
msgid "Cancel the change"
msgstr "Prekliči spremembo"

#: src/hrcek/accounts/templates/accounts/account.html
msgid "Change my email address"
msgstr "Spremeni moj e-poštni naslov"

#: src/hrcek/accounts/templates/accounts/account.html
#: src/hrcek/accounts/templates/accounts/password_change.html
msgid "Change your password"
msgstr "Spremenite geslo"

#: src/hrcek/accounts/templates/accounts/account.html
#: src/hrcek/accounts/templates/accounts/clients.html
msgid "Clients"
msgstr "Odjemalci"

#: src/hrcek/accounts/templates/accounts/account.html
msgid "Manage clients and their authorizations"
msgstr "Upravljajte odjemalce in njihova pooblastila"

#: src/hrcek/accounts/templates/accounts/clients.html
msgid ""
"Clients are scripts and other programs that act as you without a browser. "
"Each one authenticates with its own API token."
msgstr ""
"Odjemalci so skripte in drugi programi, ki delujejo v vašem imenu brez "
"brskalnika. Vsak se prijavlja s svojim API žetonom."

#: src/hrcek/accounts/templates/accounts/clients.html
msgid "Name"
msgstr "Ime"

#: src/hrcek/accounts/templates/accounts/clients.html
msgid "Created"
msgstr "Ustvarjeno"

#: src/hrcek/accounts/templates/accounts/clients.html
msgid "Last used"
msgstr "Nazadnje uporabljeno"

#: src/hrcek/accounts/templates/accounts/clients.html
#: src/hrcek/entries/templates/entries/fields.html
msgid "Delete"
msgstr "Izbriši"

#: src/hrcek/accounts/templates/accounts/clients.html
msgid "You have no tokens yet."
msgstr "Zaenkrat nimate nobenega žetona."

#: src/hrcek/accounts/templates/accounts/clients.html
msgid "Create a token"
msgstr "Ustvari žeton"

#: src/hrcek/accounts/templates/accounts/clients.html
#: src/hrcek/accounts/templates/accounts/password_change.html
#: src/hrcek/accounts/templates/accounts/password_change_done.html
msgid "Back to your account"
msgstr "Nazaj na svoj račun"

#: src/hrcek/accounts/templates/accounts/email_change_done.html
msgid "Your email address has been changed"
msgstr "Vaš e-poštni naslov je spremenjen"

#: src/hrcek/accounts/templates/accounts/email_change_done.html
#, python-format
msgid "You now sign in with %(email)s."
msgstr "Odslej se prijavljate z %(email)s."

#: src/hrcek/accounts/templates/accounts/email_change_done.html
msgid "Go to your account"
msgstr "Pojdi na svoj račun"

#: src/hrcek/accounts/templates/accounts/invitation_accept.html
msgid "Accept your invitation"
msgstr "Sprejmite povabilo"

#: src/hrcek/accounts/templates/accounts/invitation_accept.html
#, python-format
msgid "Setting up the account for %(email)s."
msgstr "Nastavljanje računa za %(email)s."

#: src/hrcek/accounts/templates/accounts/invitation_accept.html
#: src/hrcek/accounts/templates/accounts/signup.html
msgid "Create my account"
msgstr "Ustvari moj račun"

#: src/hrcek/accounts/templates/accounts/landing.html
#: src/hrcek/accounts/templates/accounts/password_reset_complete.html
msgid "Sign in"
msgstr "Prijava"

#: src/hrcek/accounts/templates/accounts/landing.html
msgid "Forgotten your password?"
msgstr "Ste pozabili geslo?"

#: src/hrcek/accounts/templates/accounts/message.html
msgid "Something went wrong"
msgstr "Nekaj je šlo narobe"

#: src/hrcek/accounts/templates/accounts/password_change.html
#: src/hrcek/accounts/templates/accounts/password_reset_confirm.html
msgid "Save my new password"
msgstr "Shrani moje novo geslo"

#: src/hrcek/accounts/templates/accounts/password_change_done.html
#: src/hrcek/accounts/templates/accounts/password_reset_complete.html
msgid "Your password has been changed"
msgstr "Vaše geslo je spremenjeno"

#: src/hrcek/accounts/templates/accounts/password_reset.html
#: src/hrcek/accounts/templates/emails/password_reset.html
#: src/hrcek/accounts/templates/emails/password_reset.subject.txt
msgid "Reset your password"
msgstr "Ponastavite geslo"

#: src/hrcek/accounts/templates/accounts/password_reset.html
msgid ""
"Enter your email address and we will send you a link to choose a new "
"password."
msgstr ""
"Vnesite svoj e-poštni naslov in poslali vam bomo povezavo za izbiro novega "
"gesla."

#: src/hrcek/accounts/templates/accounts/password_reset.html
msgid "Send the link"
msgstr "Pošlji povezavo"

#: src/hrcek/accounts/templates/accounts/password_reset_confirm.html
#: src/hrcek/accounts/templates/emails/password_reset.html
msgid "Choose a new password"
msgstr "Izberite novo geslo"

#: src/hrcek/accounts/templates/accounts/password_reset_confirm.html
msgid "This link is invalid, probably because it has already been used."
msgstr "Ta povezava ni veljavna, verjetno zato, ker je bila že uporabljena."

#: src/hrcek/accounts/templates/accounts/password_reset_confirm.html
msgid "Ask for a new one"
msgstr "Zaprosite za novo"

#: src/hrcek/accounts/templates/accounts/password_reset_done.html
#: src/hrcek/accounts/templates/accounts/signup_done.html
msgid "Check your email"
msgstr "Preverite e-pošto"

#: src/hrcek/accounts/templates/accounts/password_reset_done.html
msgid "If that address has an account here, a link is on its way."
msgstr "Če ima ta naslov tukaj račun, je povezava že na poti."

#: src/hrcek/accounts/templates/accounts/signup.html
msgid "Create an account"
msgstr "Ustvarite račun"

#: src/hrcek/accounts/templates/accounts/signup_done.html
msgid ""
"If that address can have an account here, a message is on its way. Follow "
"the link in it to finish."
msgstr ""
"Če ima ta naslov lahko račun tukaj, je sporočilo že na poti. Sledite "
"povezavi v njem, da zaključite."

#: src/hrcek/accounts/templates/emails/email_change.html
#: src/hrcek/accounts/templates/emails/email_change.subject.txt
msgid "Confirm your new email address"
msgstr "Potrdite svoj novi e-poštni naslov"

#: src/hrcek/accounts/templates/emails/email_change.html
#: src/hrcek/accounts/templates/emails/email_change.txt
msgid ""
"Confirm this address to finish moving your Hrček account to it. Until you "
"do, your current address keeps working."
msgstr ""
"Potrdite ta naslov, da nanj prenesete svoj račun v Hrčku. Do takrat vaš "
"trenutni naslov še naprej deluje."

#: src/hrcek/accounts/templates/emails/email_change.html
msgid "Confirm this address"
msgstr "Potrdi ta naslov"

#: src/hrcek/accounts/templates/emails/email_change.html
#: src/hrcek/accounts/templates/emails/email_change.txt
#: src/hrcek/accounts/templates/emails/email_confirmation.html
#: src/hrcek/accounts/templates/emails/email_confirmation.txt
#, python-format
msgid "This link stops working in %(expires_hours)s hours."
msgstr "Povezava preneha delovati čez %(expires_hours)s ur."

#: src/hrcek/accounts/templates/emails/email_change.html
#: src/hrcek/accounts/templates/emails/email_change_notice.html
#: src/hrcek/accounts/templates/emails/email_confirmation.html
#: src/hrcek/accounts/templates/emails/invitation.html
#: src/hrcek/accounts/templates/emails/password_reset.html
#: src/hrcek/accounts/templates/emails/signup_existing_account.html
msgid "You are receiving this because someone used your address with Hrček."
msgstr "To sporočilo ste prejeli, ker je nekdo uporabil vaš naslov v Hrčku."

#: src/hrcek/accounts/templates/emails/email_change_notice.html
#: src/hrcek/accounts/templates/emails/email_change_notice.subject.txt
msgid "Your email address is being changed"
msgstr "Vaš e-poštni naslov se spreminja"

#: src/hrcek/accounts/templates/emails/email_change_notice.html
#: src/hrcek/accounts/templates/emails/email_change_notice.txt
#, python-format
msgid ""
"Somebody asked to move your Hrček account to %(new_email)s. Nothing has "
"changed yet, and this address still works until that one is confirmed."
msgstr ""
"Nekdo je zahteval prenos vašega računa v Hrčku na %(new_email)s. Zaenkrat se "
"ni nič spremenilo in ta naslov deluje, dokler oni ni potrjen."

#: src/hrcek/accounts/templates/emails/email_change_notice.html
msgid "If this was not you, sign in now and cancel the change."
msgstr "Če to niste bili vi, se takoj prijavite in prekličite spremembo."

#: src/hrcek/accounts/templates/emails/email_change_notice.html
msgid "Review my account"
msgstr "Preveri moj račun"

#: src/hrcek/accounts/templates/emails/email_change_notice.txt
msgid "If this was not you, sign in now and cancel the change:"
msgstr "Če to niste bili vi, se takoj prijavite in prekličite spremembo:"

#: src/hrcek/accounts/templates/emails/email_confirmation.html
#: src/hrcek/accounts/templates/emails/email_confirmation.subject.txt
msgid "Confirm your email address"
msgstr "Potrdite svoj e-poštni naslov"

#: src/hrcek/accounts/templates/emails/email_confirmation.html
msgid "Confirm your address to finish setting up your Hrček account."
msgstr "Potrdite svoj naslov in dokončajte nastavitev računa v Hrčku."

#: src/hrcek/accounts/templates/emails/email_confirmation.html
msgid "Confirm my address"
msgstr "Potrdi moj naslov"

#: src/hrcek/accounts/templates/emails/email_confirmation.txt
msgid "Confirm your address to finish setting up your Hrček account:"
msgstr "Potrdite svoj naslov in dokončajte nastavitev računa v Hrčku:"

#: src/hrcek/accounts/templates/emails/invitation.html
#: src/hrcek/accounts/templates/emails/invitation.subject.txt
msgid "You have been invited to Hrček"
msgstr "Povabljeni ste v Hrčka"

#: src/hrcek/accounts/templates/emails/invitation.html
#, python-format
msgid ""
"%(invited_by)s invited you to join Hrček, a place to keep track of "
"interesting things found on the web."
msgstr ""
"%(invited_by)s vas vabi v Hrčka, kjer shranjujemo zanimive stvari s spleta."

#: src/hrcek/accounts/templates/emails/invitation.html
msgid "Accept the invitation"
msgstr "Sprejmi povabilo"

#: src/hrcek/accounts/templates/emails/invitation.html
#, python-format
msgid ""
"This link stops working on %(expires_at)s. If you were not expecting this, "
"ignore this message."
msgstr ""
"Povezava preneha delovati %(expires_at)s. Če tega niste pričakovali, "
"sporočilo prezrite."

#: src/hrcek/accounts/templates/emails/invitation.txt
#, python-format
msgid "%(invited_by)s invited you to join Hrček."
msgstr "%(invited_by)s vas vabi v Hrčka."

#: src/hrcek/accounts/templates/emails/invitation.txt
msgid "Accept the invitation:"
msgstr "Sprejmite povabilo:"

#: src/hrcek/accounts/templates/emails/invitation.txt
#, python-format
msgid "This link stops working on %(expires_at)s."
msgstr "Povezava preneha delovati %(expires_at)s."

#: src/hrcek/accounts/templates/emails/password_reset.html
msgid "Use the button below to choose a new password for your Hrček account."
msgstr "Z gumbom spodaj izberite novo geslo za svoj račun v Hrčku."

#: src/hrcek/accounts/templates/emails/password_reset.html
msgid ""
"If you did not ask for this, ignore this message and nothing will change."
msgstr ""
"Če tega niste zahtevali, sporočilo prezrite in nič se ne bo spremenilo."

#: src/hrcek/accounts/templates/emails/password_reset.txt
msgid "Choose a new password for your Hrček account:"
