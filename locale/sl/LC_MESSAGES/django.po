msgstr "Poimenujte žeton."

#: src/hrcek/accounts/api.py
msgid "That name is too long."
msgstr "To ime je predolgo."

#: src/hrcek/accounts/api.py
msgid "That expiry has already passed."
msgstr "Ta datum poteka je že mimo."

#: src/hrcek/accounts/apps.py
msgid "Accounts"
msgstr "Računi"

#: src/hrcek/accounts/errors.py
msgid "The email address or password is not correct."
msgstr "E-poštni naslov ali geslo ni pravilno."

#: src/hrcek/accounts/errors.py
msgid "Confirm your email address before signing in."
msgstr "Pred prijavo potrdite svoj e-poštni naslov."

#: src/hrcek/accounts/errors.py
msgid "You must sign in to do that."
msgstr "Za to dejanje se morate prijaviti."

#: src/hrcek/accounts/errors.py
msgid "This API token is invalid or has expired."
msgstr "Ta API-žeton ni veljaven ali je potekel."

#: src/hrcek/accounts/errors.py
msgid "The request could not be verified. Try again."
msgstr "Zahteve ni bilo mogoče preveriti. Poskusite znova."

#: src/hrcek/accounts/errors.py
msgid "Creating a token needs a signed-in session, not another token."
msgstr "Za ustvarjanje žetona je potrebna prijavljena seja, ne drug žeton."

#: src/hrcek/accounts/errors.py
msgid "This invitation link is not valid. It may have expired or been used."
msgstr ""
"Ta povezava za povabilo ni veljavna. Morda je potekla ali bila že "
"uporabljena."

#: src/hrcek/accounts/errors.py
msgid "That display name is already taken."
msgstr "To prikazno ime je že zasedeno."

#: src/hrcek/accounts/errors.py
msgid "This email address is not allowed to create an account here."
msgstr "Ta e-poštni naslov tukaj ne more ustvariti računa."

#: src/hrcek/accounts/errors.py
msgid "This confirmation link is not valid. It may have expired."
msgstr "Ta potrditvena povezava ni veljavna. Morda je potekla."

#: src/hrcek/accounts/errors.py
msgid "This email change link is not valid. It may have expired."
msgstr ""
"Ta povezava za spremembo e-poštnega naslova ni veljavna. Morda je potekla."

#: src/hrcek/accounts/errors.py
msgid "That email address is already in use."
msgstr "Ta e-poštni naslov je že v uporabi."

#: src/hrcek/accounts/forms.py
#: src/hrcek/accounts/templates/accounts/account.html
msgid "Display name"
msgstr "Prikazno ime"

#: src/hrcek/accounts/forms.py
#: src/hrcek/accounts/templates/accounts/account.html
msgid "Optional. You can sign in with this instead of your email."
msgstr "Neobvezno. S tem se lahko prijavite namesto z e-poštnim naslovom."

#: src/hrcek/accounts/forms.py
#: src/hrcek/accounts/templates/accounts/account.html
msgid "Password"
msgstr "Geslo"

#: src/hrcek/accounts/forms.py
msgid "Repeat password"
msgstr "Ponovite geslo"

#: src/hrcek/accounts/forms.py
msgid "The two passwords do not match."
msgstr "Gesli se ne ujemata."

#: src/hrcek/accounts/forms.py
#: src/hrcek/accounts/templates/accounts/account.html
msgid "Email address"
msgstr "E-poštni naslov"

#: src/hrcek/accounts/forms.py
msgid "That public name is already taken."
msgstr "To javno ime je že zasedeno."

#: src/hrcek/accounts/forms.py
msgid "New email address"
msgstr "Nov e-poštni naslov"

#: src/hrcek/accounts/forms.py
msgid "Current password"
msgstr "Trenutno geslo"

#: src/hrcek/accounts/forms.py
msgid "That is already your email address."
msgstr "To je že vaš e-poštni naslov."

#: src/hrcek/accounts/forms.py
msgid "Token name"
msgstr "Ime žetona"

#: src/hrcek/accounts/management/commands/compile_emails.py
#, python-format
msgid ""
"Email templates are out of date: %(names)s. Run: uv run python manage.py "
"compile_emails"
msgstr ""
"E-poštne predloge niso posodobljene: %(names)s. Zaženite: uv run python "
"manage.py compile_emails"

#: src/hrcek/accounts/management/commands/compile_emails.py
msgid "Email templates are up to date."
msgstr "E-poštne predloge so posodobljene."

#: src/hrcek/accounts/management/commands/compile_emails.py
#, python-format
msgid "Compiled: %(names)s"
msgstr "Prevedeno: %(names)s"

#: src/hrcek/accounts/management/commands/preview_emails.py
#, python-format
msgid "Previews written to %(path)s"
msgstr "Predogledi so zapisani v %(path)s"

#: src/hrcek/accounts/management/commands/preview_emails.py
#, python-format
msgid "Open %(path)s"
msgstr "Odprite %(path)s"

