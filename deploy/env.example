# Copy to .env beside compose.yaml and fill in. Keep it mode 600.
HRCEK_TAG=
HRCEK_SECRET_KEY=
HRCEK_ALLOWED_HOSTS=hrcek.example.com
HRCEK_BASE_URL=https://hrcek.example.com
HRCEK_FROM_EMAIL=hrcek@example.com
HRCEK_SMTP_HOST=
HRCEK_SMTP_PORT=587
HRCEK_SMTP_USER=
HRCEK_SMTP_PASSWORD=
# One reverse proxy in front: trust its forwarding headers.
HRCEK_PROXY_COUNT=1
# Snapshots to keep in data/backups.
HRCEK_BACKUP_KEEP=10
# Optional.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
